---
/*
 * Generated cover art for a project: a blueprint grid plus a blob unique to the
 * project (its seed comes from the index). Used until real screenshots exist,
 * and still recognisably "on brand" with the hero blob.
 */
import { blobPath } from '../scripts/blob-shape';

interface Props {
  seed: number;
}

const { seed } = Astro.props;
---

<div class="art" aria-hidden="true">
  <svg class="art__svg" viewBox="0 0 200 200" preserveAspectRatio="xMidYMid meet">
    <path class="art__ring" d={blobPath(seed + 7)}></path>
    <path class="art__blob" d={blobPath(seed)}></path>
  </svg>
</div>

<style>
  .art {
    position: relative;
    display: grid;
    place-items: center;
    height: 100%;
    overflow: hidden;
    background-color: var(--color-surface);
    /* Blueprint grid: two sets of thin lines every 32px. */
    background-image:
      linear-gradient(var(--color-border) var(--border-width), transparent var(--border-width)),
      linear-gradient(90deg, var(--color-border) var(--border-width), transparent var(--border-width));
    background-size: var(--space-6) var(--space-6);
    background-position: center;
  }

  .art__svg {
    width: min(70%, 22rem);
    overflow: visible;
    transition:
      rotate var(--dur-slow) var(--ease-out),
      scale var(--dur-slow) var(--ease-out);
  }

  .art__blob {
    fill: var(--color-accent);
    stroke: var(--blob-stroke);
    stroke-width: 0.6;
  }

  .art__ring {
    fill: none;
    stroke: var(--color-text);
    stroke-width: 0.5;
    stroke-dasharray: 2 3;
    transform-origin: center;
    translate: 14px -10px;
  }

  /* The card (ProjectCard) is the hover target. */
  :global(.card:hover) .art__svg,
  :global(.card:focus-within) .art__svg {
    rotate: 25deg;
    scale: 1.08;
  }
</style>
