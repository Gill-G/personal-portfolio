---
/*
 * Cover art for a project card: a blueprint grid with a dashed outline, plus either
 * the project's logo or, if it has none, a blob unique to the project (its seed
 * comes from the index), on brand with the hero blob.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { blobPath } from '../scripts/blob-shape';

interface Props {
  seed: number;
  logo?: ImageMetadata;
}

const { seed, logo } = Astro.props;
---

<div class:list={['art', logo && 'art--screen']} aria-hidden="true">
  <svg class="art__svg" viewBox="0 0 200 200" preserveAspectRatio="xMidYMid meet">
    <path class="art__ring" d={blobPath(seed + 7)}></path>
    {!logo && <path class="art__blob" d={blobPath(seed)} />}
  </svg>
  {
    logo && (
      <span class="art__logo">
        {/* Astro resizes the source PNG into small WebP files; the browser picks one. */}
        <Image
          src={logo}
          alt=""
          widths={[240, 360, 480, 720]}
          sizes="(min-width: 56rem) 22rem, 70vw"
          format="webp"
        />
      </span>
    )
  }
</div>

<style>
  .art {
    position: relative;
    display: grid;
    place-items: center;
    height: 100%;
    overflow: hidden;
    background-color: var(--color-surface);
    /* Blueprint grid: two sets of thin lines every 32px. */
    background-image:
      linear-gradient(var(--color-border) var(--border-width), transparent var(--border-width)),
      linear-gradient(90deg, var(--color-border) var(--border-width), transparent var(--border-width));
    background-size: var(--space-6) var(--space-6);
    background-position: center;
  }

  /* Logo panels: a dark "screen" in both themes (see --art-screen-* in tokens.css). */
  .art--screen {
    background-color: var(--art-screen-bg);
    background-image:
      linear-gradient(var(--art-screen-line) var(--border-width), transparent var(--border-width)),
      linear-gradient(90deg, var(--art-screen-line) var(--border-width), transparent var(--border-width));
  }

  .art--screen .art__ring {
    stroke: var(--art-screen-ring);
  }

  /* The outline and the logo sit in the same grid cell, stacked. */
  .art > * {
    grid-area: 1 / 1;
  }

  .art__svg {
    width: min(70%, 22rem);
    overflow: visible;
    transition:
      rotate var(--dur-slow) var(--ease-out),
      scale var(--dur-slow) var(--ease-out);
  }

  .art__blob {
    fill: var(--color-accent);
    stroke: var(--blob-stroke);
    stroke-width: 0.6;
  }

  .art__ring {
    fill: none;
    stroke: var(--color-text);
    stroke-width: 0.5;
    stroke-dasharray: 2 3;
    transform-origin: center;
    translate: 14px -10px;
  }

  .art__logo {
    display: grid;
    place-items: center;
    width: min(64%, 20rem);
    height: 78%;
    transition:
      rotate var(--dur-slow) var(--ease-out),
      scale var(--dur-slow) var(--ease-out);
  }

  .art__logo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* The card (ProjectCard) is the hover target. */
  :global(.card:hover) .art__svg,
  :global(.card:focus-within) .art__svg {
    rotate: 25deg;
    scale: 1.08;
  }

  /* Logos only tilt a little, so any text in them stays readable. */
  :global(.card:hover) .art__logo,
  :global(.card:focus-within) .art__logo {
    rotate: -4deg;
    scale: 1.05;
  }
</style>
