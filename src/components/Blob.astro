---
/*
 * The site's recurring abstract motif. Rendered as a static shape at build time;
 * effects.ts then makes it slowly morph (and, with `follow`, lean toward the cursor).
 */
import { blobPath } from '../scripts/blob-shape';

interface Props {
  seed?: number;
  follow?: boolean;
  class?: string;
}

const { seed = 1, follow = false, class: className } = Astro.props;
---

<svg
  class:list={['blob', className]}
  viewBox="0 0 200 200"
  aria-hidden="true"
  focusable="false"
  data-blob
  data-seed={seed}
  data-follow={follow || undefined}
>
  <path d={blobPath(seed)}></path>
</svg>

<style>
  .blob {
    overflow: visible;
    will-change: translate;
  }

  .blob path {
    fill: var(--color-accent);
    stroke: var(--blob-stroke);
    stroke-width: 0.6;
  }
</style>
