---
/*
 * Fixed header: GG logo (top left, back to top), section tabs, a light/dark
 * toggle and a résumé button (top right).
 * On small screens the tabs collapse into a "Menu" button that opens a
 * full-screen list. Behaviour lives in src/scripts/nav.ts and theme.ts.
 */
import Logo from './Logo.astro';
import { sections } from '../config/nav';
import { site } from '../config/site';
import { url } from '../utils/url';
import { twoDigits } from '../utils/format';

// Links point at the home page's sections (e.g. /#about), so they also work from
// other pages like /resume/. On the home page they still glide (smooth-scroll.ts).
const home = (hash: string) => url(`#${hash}`);
const resumePage = url('resume/');
const onResumePage = Astro.url.pathname.replace(/\/$/, '') === resumePage.replace(/\/$/, '');
---

<header class="header" data-header>
  <div class="header__inner container">
    <a href={home('home')} class="header__logo" aria-label={`${site.name}, back to top`}>
      <Logo />
    </a>

    <div class="header__actions">
      <nav class="header__nav" aria-label="Sections">
        <ul role="list" class="tabs" data-tabs data-pill="off">
          {sections.map((section, i) => (
            <li>
              <a href={home(section.id)} class="tab" data-tab={section.id}>
                <span class="tab__num" aria-hidden="true">
                  {twoDigits(i + 1)}
                </span>
                {section.label}
              </a>
            </li>
          ))}
        </ul>

        <!-- Between the tabs (desktop) and the Menu button (phones), so it sits in the
             same spot on both. Shows the icon of the theme it switches to. -->
        <button type="button" class="theme-toggle" aria-label="Switch theme" data-theme-toggle>
          <svg
            class="theme-toggle__icon theme-toggle__sun"
            viewBox="0 0 24 24"
            aria-hidden="true"
            focusable="false"
          >
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"></path>
          </svg>
          <svg
            class="theme-toggle__icon theme-toggle__moon"
            viewBox="0 0 24 24"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M19.5 14.5A7.5 7.5 0 0 1 9.5 4.5a7.5 7.5 0 1 0 10 10Z"></path>
          </svg>
        </button>

        <button
          type="button"
          class="menu-button mono"
          aria-expanded="false"
          aria-controls="menu"
          data-menu-button
        >
          <span class="menu-button__icon" aria-hidden="true"></span>
          Menu
        </button>
      </nav>

      {site.links.resume && (
        <a href={resumePage} class="resume mono" aria-current={onResumePage ? 'page' : undefined}>
          Résumé
        </a>
      )}
    </div>
  </div>

  <!-- Small-screen menu. Hidden until the Menu button opens it. -->
  <div id="menu" class="menu" hidden>
    <ul role="list" class="menu__list container">
      {sections.map((section, i) => (
        <li>
          <a href={home(section.id)} class="menu__link" data-tab={section.id}>
            <span class="mono">{twoDigits(i + 1)}</span>
            {section.label}
          </a>
        </li>
      ))}
    </ul>
    <p class="menu__footer container mono">
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </p>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-header);
    transition:
      background-color var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out),
      translate var(--dur-slow) var(--ease-out);
    border-bottom: var(--border-width) solid transparent;
  }

  /* Hidden while scrolling down (nav.ts). Slides up just past the top edge. */
  .header[data-hidden] {
    translate: 0 -100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .header {
      transition: none;
    }
  }

  /* Once scrolled, a frosted backdrop keeps the tabs readable over content. */
  .header[data-scrolled] {
    background: var(--color-header-bg);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border-bottom-color: var(--color-border);
  }

  .header[data-menu-open] {
    background: var(--color-bg);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .header__logo {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    text-decoration: none;
  }

  /* ---- Desktop tabs ---- */

  .tabs {
    position: relative;
    display: none;
    gap: var(--space-1);
    padding: var(--space-1);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-pill);
  }

  /* The sliding accent pill. nav.ts sets --pill-x and --pill-w on the list. */
  .tabs::before {
    content: '';
    position: absolute;
    top: var(--space-1);
    bottom: var(--space-1);
    left: 0;
    width: var(--pill-w, 0);
    translate: var(--pill-x, 0) 0;
    background: var(--color-accent);
    border-radius: var(--radius-pill);
    transition:
      translate var(--dur-slow) var(--ease-out),
      width var(--dur-slow) var(--ease-out),
      opacity var(--dur-base) var(--ease-out);
  }

  .tabs[data-pill='off']::before {
    opacity: 0;
  }

  .tab {
    position: relative; /* sits above the pill */
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    transition: color var(--dur-base) var(--ease-out);
  }

  .tab__num {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    transition: color var(--dur-base) var(--ease-out);
  }

  .tab:hover .tab__num {
    color: var(--color-text);
  }

  .tab[aria-current],
  .tab[aria-current] .tab__num {
    color: var(--color-on-accent);
  }

  /* ---- Theme toggle ----
   * Hidden without JavaScript, since only theme.ts can switch the theme. */

  .theme-toggle {
    display: none;
    place-items: center;
    width: var(--touch-target);
    height: var(--touch-target);
    padding: 0;
    background: none;
    color: inherit;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      scale var(--dur-fast) var(--ease-out);
  }

  :global(.js) .theme-toggle {
    display: inline-grid;
  }

  .theme-toggle:hover {
    border-color: var(--color-border-strong);
  }

  .theme-toggle:active {
    scale: 0.94;
  }

  .theme-toggle__icon {
    grid-area: 1 / 1;
    width: var(--space-5);
    height: var(--space-5);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* A moon while the page is light, a sun while it's dark. Same rules as the theme
     blocks in tokens.css: a picked theme wins, otherwise the OS decides. */
  .theme-toggle__sun,
  :global(:root[data-theme='dark']) .theme-toggle__moon {
    display: none;
  }

  :global(:root[data-theme='dark']) .theme-toggle__sun {
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme-toggle__sun {
      display: block;
    }

    :global(:root:not([data-theme='light'])) .theme-toggle__moon {
      display: none;
    }
  }

  /* After a click, the new icon spins in (theme.ts sets data-switched). */
  @media (prefers-reduced-motion: no-preference) {
    .theme-toggle[data-switched] .theme-toggle__icon {
      animation: theme-icon-in var(--dur-base) var(--ease-out);
    }
  }

  @keyframes theme-icon-in {
    from {
      opacity: 0;
      rotate: -90deg;
      scale: 0.6;
    }
  }

  /* ---- Résumé button ----
   * Inverted pill (text color as the fill) so it reads as an action, distinct
   * from the volt pill that marks the active tab. Fills volt on hover. */

  .resume {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-target);
    /* Mono labels have letter-spacing, which leaves a small invisible gap after the
       last letter. Taking it off the right padding keeps the word truly centered. */
    padding: 0 calc(var(--space-5) - var(--tracking-label)) 0 var(--space-5);
    /* All-caps text rides ~1px high (fonts keep room below for letters like g and p).
       2px of top padding moves the centered word down 1px, to true optical center. */
    padding-top: calc(var(--border-width) * 2);
    font-weight: 700;
    background: var(--color-text);
    color: var(--color-bg);
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition:
      background-color var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out),
      scale var(--dur-fast) var(--ease-out);
  }

  .resume:hover {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .resume:active {
    scale: 0.97;
  }

  /* ---- Small-screen menu ---- */

  .menu-button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--touch-target);
    padding: 0 var(--space-4);
    background: none;
    color: inherit;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-pill);
    cursor: pointer;
  }

  /* Two bars that turn into an X when the menu is open. */
  .menu-button__icon {
    position: relative;
    width: var(--space-4);
    height: var(--space-2);
  }

  .menu-button__icon::before,
  .menu-button__icon::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: var(--line-medium);
    background: currentColor;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .menu-button__icon::before {
    top: 0;
  }

  .menu-button__icon::after {
    bottom: 0;
  }

  .menu-button[aria-expanded='true'] .menu-button__icon::before {
    transform: translateY(3px) rotate(45deg);
  }

  .menu-button[aria-expanded='true'] .menu-button__icon::after {
    transform: translateY(-3px) rotate(-45deg);
  }

  .menu {
    position: fixed;
    inset: var(--header-h) 0 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-block: var(--space-7) var(--space-6);
    background: var(--color-bg);
  }

  .menu[hidden] {
    display: none;
  }

  .menu__link {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 800;
    font-stretch: 75%;
    line-height: 1;
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
    text-decoration: none;
  }

  .menu__link .mono {
    color: var(--color-text-muted);
  }

  .menu__link[aria-current] {
    color: var(--color-accent-text);
  }

  @media (prefers-reduced-motion: no-preference) {
    .menu:not([hidden]) .menu__link {
      animation: menu-in var(--dur-slow) var(--ease-out) both;
    }

    .menu li:nth-child(2) .menu__link {
      animation-delay: 60ms;
    }

    .menu li:nth-child(3) .menu__link {
      animation-delay: 120ms;
    }

    .menu li:nth-child(4) .menu__link {
      animation-delay: 180ms;
    }
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(40%);
    }
  }

  .menu__footer a {
    color: var(--color-text-muted);
  }

  @media (min-width: 48rem) {
    .tabs {
      display: flex;
    }

    .menu-button,
    .menu {
      display: none;
    }
  }
</style>
