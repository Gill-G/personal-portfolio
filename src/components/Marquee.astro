---
/*
 * A band of huge words scrolling sideways between sections. Decorative only,
 * so it's hidden from screen readers. effects.ts moves it (faster when you
 * scroll faster, reversed when you scroll up).
 */
interface Props {
  words: string[];
}

const { words } = Astro.props;

// One "copy" must be wider than the screen, or the band runs out of words and
// shows a blank gap before it loops. Repeat short word lists until a copy has at
// least 16 words: wide enough for a 4K screen even at the largest font size.
const MIN_WORDS_PER_COPY = 16;
const repeats = Math.ceil(MIN_WORDS_PER_COPY / words.length);
const copyWords = Array.from({ length: repeats }, () => words).flat();

// The copy is rendered twice so the band can loop seamlessly.
const copies = [0, 1];
---

<div class="marquee" aria-hidden="true" data-marquee>
  <div class="marquee__track" data-marquee-track>
    {
      copies.map(() =>
        copyWords.map((word) => (
          <span class="marquee__item">
            <span class="marquee__word">{word}</span>
            <span class="marquee__star">✦</span>
          </span>
        )),
      )
    }
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    padding-block: var(--space-5);
    border-block: var(--border-width) solid var(--color-border);
    user-select: none;
  }

  .marquee__track {
    display: flex;
    width: max-content;
    will-change: transform;
  }

  .marquee__item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-6);
    padding-right: var(--space-6);
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 800;
    font-stretch: 75%;
    line-height: 1;
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* Alternate filled and outlined words for rhythm. */
  .marquee__item:nth-child(even) .marquee__word {
    color: transparent;
    -webkit-text-stroke: var(--border-width) var(--color-text);
  }

  .marquee__star {
    font-size: 0.4em;
    color: var(--color-accent-text);
  }
</style>
