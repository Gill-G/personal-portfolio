---
import SectionHeading from '../SectionHeading.astro';
import { about } from '../../data/about';

// Split the lead on [brackets] so the bracketed words can be highlighted.
// 'I turn [messy problems] into...' -> ['I turn ', 'messy problems', ' into...']
// Every odd-numbered piece is a highlight.
const leadParts = about.lead.split(/\[|\]/);
---

<section id="about" class="about" aria-labelledby="about-title" tabindex="-1">
  <div class="container">
    <SectionHeading number="01" title="About" id="about-title" />

    <div class="about__grid">
      <p class="about__lead" data-reveal>
        {leadParts.map((part, i) => (i % 2 ? <mark>{part}</mark> : part))}
      </p>

      <dl class="about__facts" data-reveal>
        {
          about.facts.map((fact) => (
            <div class="about__fact">
              <dt class="mono">{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))
        }
      </dl>

      <div class="about__body">
        {
          about.body.map((paragraph, i) => (
            <p data-reveal style={`--reveal-delay: ${i * 80}ms`}>
              {paragraph}
            </p>
          ))
        }

        <h3 class="about__stack-title mono">Toolkit</h3>
        <ul role="list" class="about__stack" data-reveal>
          {about.stack.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    padding-block: var(--space-section);
  }

  .about__grid {
    display: grid;
    gap: var(--space-8);
  }

  .about__lead {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 600;
    line-height: var(--leading-heading);
    letter-spacing: -0.02em;
  }

  .about__lead mark {
    padding: 0 0.12em;
    background: var(--color-accent);
    color: var(--color-on-accent);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .about__facts {
    display: grid;
    align-content: start;
    border-top: var(--border-width) solid var(--color-border-strong);
  }

  .about__fact {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .about__fact dt {
    color: var(--color-text-muted);
  }

  .about__fact dd {
    font-weight: 600;
    text-align: right;
  }

  .about__body {
    display: grid;
    gap: var(--space-5);
    max-width: var(--measure);
    color: var(--color-text-muted);
  }

  .about__stack-title {
    margin-top: var(--space-5);
    color: var(--color-text);
  }

  .about__stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .about__stack li {
    padding: var(--space-2) var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-pill);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .about__stack li:hover {
    background: var(--color-accent);
    color: var(--color-on-accent);
    border-color: var(--color-accent);
  }

  /* Desktop: the lead spans wide; facts sit left, body text is pushed right. */
  @media (min-width: 64rem) {
    .about__grid {
      grid-template-columns: repeat(12, 1fr);
      column-gap: var(--space-6);
    }

    .about__lead {
      grid-column: 1 / span 10;
    }

    .about__facts {
      grid-column: 1 / span 4;
    }

    .about__body {
      grid-column: 6 / span 6;
    }
  }
</style>
