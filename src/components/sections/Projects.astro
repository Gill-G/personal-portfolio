---
/*
 * Projects come from Markdown files in src/content/projects/ (see _template.md).
 * Add a file and it appears here automatically, sorted by `order`.
 */
import { getCollection } from 'astro:content';
import SectionHeading from '../SectionHeading.astro';
import ProjectCard from '../ProjectCard.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<section id="projects" class="projects" aria-labelledby="projects-title" tabindex="-1">
  <div class="container">
    <SectionHeading
      number="03"
      title="Projects"
      id="projects-title"
      kicker="What I've built so far. The best is still ahead."
    />

    <div class="projects__grid">
      {projects.map((project, i) => <ProjectCard project={project} index={i} />)}
    </div>

  </div>
</section>

<style>
  .projects {
    padding-block: var(--space-section);
  }

  .projects__grid {
    display: grid;
    gap: var(--space-9) var(--space-6);
  }

  /*
   * An uneven, magazine-like rhythm instead of identical cards:
   * wide + narrow, then narrow + wide, repeating every 4 projects.
   * The narrow cards drop lower and use a taller image.
   */
  @media (min-width: 56rem) {
    .projects__grid {
      grid-template-columns: repeat(12, 1fr);
    }

    .projects__grid > :global(:nth-child(4n + 1)),
    .projects__grid > :global(:nth-child(4n + 4)) {
      grid-column: span 7;
    }

    .projects__grid > :global(:nth-child(4n + 2)),
    .projects__grid > :global(:nth-child(4n + 3)) {
      grid-column: span 5;
      --art-ratio: 4 / 5;
    }

    .projects__grid > :global(:nth-child(4n + 2)) {
      margin-top: var(--space-10);
    }

    /* A card left alone on the last row (e.g. the 3rd of 3) spans the full
       width with a wide, banner-shaped image instead of leaving a gap. */
    .projects__grid > :global(:nth-child(4n + 1):last-child),
    .projects__grid > :global(:nth-child(4n + 3):last-child) {
      grid-column: 1 / -1;
      --art-ratio: 21 / 9;
    }
  }
</style>
