---
import SectionHeading from '../SectionHeading.astro';
import Blob from '../Blob.astro';
import { site } from '../../config/site';
import { withBase } from '../../utils/url';

// Only links with a value are shown (see site.ts).
const links = [
  { label: 'GitHub', href: site.links.github },
  { label: 'LinkedIn', href: site.links.linkedin },
  { label: 'Résumé', href: site.links.resume && withBase(site.links.resume) },
].filter((link) => link.href);
---

<section id="contact" class="contact" aria-labelledby="contact-title" tabindex="-1">
  <div class="contact__blob-wrap">
    <Blob seed={4.2} class="contact__blob" />
  </div>

  <div class="container contact__inner">
    <SectionHeading number="04" title="Contact" id="contact-title" />

    <p class="contact__headline" data-reveal>
      Let's build <span class="contact__outline">something</span> together.
    </p>

    <div class="contact__email-row" data-reveal style="--reveal-delay: 100ms">
      <a href={`mailto:${site.email}`} class="contact__email">
        {site.email}
        <span class="contact__arrow" aria-hidden="true">↗</span>
      </a>
      <button type="button" class="contact__copy mono" data-copy={site.email}>
        <span data-copy-label aria-live="polite">Copy email</span>
      </button>
    </div>

    <ul role="list" class="contact__links" data-reveal style="--reveal-delay: 200ms">
      {
        links.map((link) => (
          <li>
            <a href={link.href} class="mono">
              {link.label}
              <span aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .contact {
    position: relative;
    padding-block: var(--space-section);
    overflow: hidden;
  }

  .contact__inner {
    position: relative;
  }

  .contact__blob-wrap {
    position: absolute;
    right: -20%;
    bottom: -25%;
    width: clamp(18rem, 50vw, 40rem);
    aspect-ratio: 1;
    opacity: 0.9;
    pointer-events: none;
  }

  .contact__headline {
    max-width: 14ch;
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 800;
    font-stretch: 75%;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
    mix-blend-mode: var(--hero-blend);
  }

  .contact__outline {
    color: transparent;
    -webkit-text-stroke: var(--border-width) var(--color-text);
  }

  .contact__email-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  .contact__email {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-xl);
    font-weight: 600;
    overflow-wrap: anywhere;
    text-decoration: none;
    /* An accent underline that thickens on hover. */
    background: linear-gradient(var(--color-accent), var(--color-accent)) 0 100% / 100% 3px
      no-repeat;
    transition:
      background-size var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out);
  }

  .contact__email:hover {
    background-size: 100% 100%;
    color: var(--color-on-accent);
  }

  .contact__copy {
    min-height: 44px;
    padding: 0 var(--space-5);
    background: none;
    color: inherit;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  .contact__copy:hover {
    border-color: var(--color-border-strong);
  }

  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    margin-top: var(--space-7);
  }

  .contact__links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    text-decoration: none;
    color: var(--color-text-muted);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .contact__links a:hover {
    color: var(--color-text);
  }

  @media (min-width: 64rem) {
    .contact__blob-wrap {
      right: 4%;
      bottom: 8%;
    }
  }
</style>
