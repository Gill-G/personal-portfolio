---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';
import { url } from '../utils/url';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;

// Vercel sets VERCEL=1 during its builds. Analytics only exists there, so the GitHub
// Pages backup leaves the script out instead of requesting a file that isn't there.
const onVercel = Boolean(process.env.VERCEL);

// Point search engines at the main site (site.url), whichever deploy served this page.
// Strip the deploy's base path first: '/personal-portfolio/' on GitHub Pages becomes '/'.
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname.slice(basePath.length) || '/', site.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <meta name="theme-color" content="#0c0c0e" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ece8df" media="(prefers-color-scheme: light)" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <!-- Thumbnail for link previews (LinkedIn, Slack...): public/og-image.png, 1200 x 627.
         Always an absolute URL on the main site, since link-preview tools require one. -->
    <meta property="og:image" content={`${site.url}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="627" />
    <meta property="og:image:alt" content={`${site.name}'s portfolio home screen`} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Fonts: Bricolage Grotesque (display + body, variable width) and JetBrains Mono (labels). -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,300..800&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <!-- Runs before paint: marks that JS is on, so reveal animations can hide content
         without ever leaving it hidden for visitors who have JS disabled. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <!-- Vercel Web Analytics (enabled in the Vercel dashboard). Vercel serves the script
         itself, so there's no npm package. The first line queues events until it loads. -->
    {
      onVercel && (
        <>
          <script is:inline>
            window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
          </script>
          <script is:inline defer src="/_vercel/insights/script.js"></script>
        </>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <script>
      import '../scripts/smooth-scroll';
      import '../scripts/nav';
      import '../scripts/effects';
      import '../scripts/copy';
    </script>
  </body>
</html>
